# Vercel開発環境用のカスタムDockerイメージ
FROM node:20-alpine

# 必要なパッケージを事前にインストール
RUN apk add --no-cache \
    git \
    python3 \
    make \
    g++ \
    openssl \
    openssl-dev \
    libc6-compat \
    postgresql-client \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    font-noto-cjk

# pnpmをグローバルにインストール（Node 20系と互換のあるバージョンに固定）
RUN npm install -g pnpm@10.28.0

# pnpmのパスを確認
RUN which pnpm && pnpm --version

WORKDIR /app

# デフォルトのシェルを設定（shを使用）
SHELL ["/bin/sh", "-c"]
